# Listen on HTTP port 80 (since we have no domain name, SSL is disabled)
:80 {
    # Route API calls to the Express container
    handle /api/* {
        reverse_proxy backend:5050
    }

    # Route WebSockets / Socket.IO to the Express container
    handle /socket.io/* {
        reverse_proxy backend:5050
    }

    # Serve static frontend files and fallback for React Router
    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
